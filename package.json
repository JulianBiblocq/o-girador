{
  "name": "ogirador",
  "private": true,
  "license": "UNLICENSED",
  "version": "1.1.4",
  "type": "module",
  "scripts": {
    "predev": "node scripts/updatePresets.js && node scripts/copyAudio.js",
    "dev": "vite --port=5174 --host=0.0.0.0",
    "prebuild": "node scripts/updatePresets.js && node scripts/copyAudio.js",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "deploy": "vite build && firebase deploy --only hosting:sequenceur",
    "deploy-test": "cross-env DEPLOY_ENV=test vite build && npx gh-pages -d dist -e test --add",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:vocal": "playwright test e2e/vocal-chain.spec.ts",
    "backup:presets": "node scripts/backup-cloud-presets.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-persist-client": "^5.104.5",
    "@types/dompurify": "^3.2.0",
    "canvas-confetti": "^1.9.4",
    "dompurify": "^3.4.17",
    "firebase": "^12.19.0",
    "idb-keyval": "^6.2.6",
    "immer": "^11.2.3",
    "lucide-react": "^1.60.0",
    "lz-string": "^1.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^3.0.0",
    "tone": "^15.1.22",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "knip": "^6.42.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^1.3.0"
  }
}
